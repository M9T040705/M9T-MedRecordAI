# ========= 复制本文件为 .env 后填写 =========

# --- LLM（可选；不填则使用规则抽取）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- OCR（可选；auto=有 PaddleOCR 则用，mock=演示模式，off=关闭）---
OCR_MODE=auto

# --- 存储（连不上自动降级 SQLite）---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=medical_platform

# --- 鉴权（JWT 密钥）---
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRE_HOURS=12
